# ============================================================
# KobraBot — .gitignore
# ============================================================

# ==============================
# 📦 DÉPENDANCES
# ==============================
node_modules/
dist/
build/

# ==============================
# 🔐 SECRETS & ENVIRONNEMENT
# ==============================
.env
.env.local
.env.production
.env.staging

# Fichiers de données sensibles
data/security.json
Data/security.json

# ==============================
# 📜 LOGS
# ==============================
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================
# 🔒 FICHIERS DE LOCK REDONDANTS
# (garder uniquement package-lock.json)
# ==============================
bun.lock
pnpm-lock.yaml
yarn.lock

# ==============================
# 📂 FICHIERS TEMPORAIRES
# ==============================
*.tmp
*.temp
*.bak
*.cache
.cache/
tmp/
temp/

# ==============================
# 🖼️ ASSETS LOURDS (optionnel)
# ==============================
# kbrp_emojis/ peut être exclu si trop lourd
# Décommenter si nécessaire :
# kbrp_emojis/

# ==============================
# 💻 IDE / ÉDITEURS
# ==============================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==============================
# 📚 DOCUMENTATION INTERNE
# ==============================
doc/
.api_info.md

# ==============================
# ⚙️ RUNTIME / OS
# ==============================
.npm/
.pnpm-store/
.node_repl_history
coverage/
.nyc_output/
