# ============================================
# 🤖 CONFIGURATION BOT DISCORD KOBRABOT (EXEMPLE)
# ============================================

# ============================================
# 📌 MODE & TOKENS DISCORD
# ============================================
# Mode: FALSE = Test | TRUE = Production
PRODUCTION=FALSE

# Token du bot Discord (mode TEST)
CLIENT_TOKEN_TEST=VOTRE_TOKEN_DISCORD_TEST_ICI

# Token du bot Discord (mode PRODUCTION)
CLIENT_TOKEN_PROD=VOTRE_TOKEN_DISCORD_PROD_ICI

# ID de l'application Discord (mode TEST)
CLIENT_ID_TEST=VOTRE_CLIENT_ID_TEST_ICI

# ID de l'application Discord (mode PRODUCTION)
CLIENT_ID_PROD=VOTRE_CLIENT_ID_PROD_ICI


# ============================================
# 🗄️ BASE DE DONNÉES MySQL
# ============================================
SQL_HOST=127.0.0.1
SQL_PORT=3306
SQL_USER=votre_utilisateur_db
SQL_PASSWORD=votre_mot_de_passe_db
SQL_BASE=votre_base_de_donnees


# ============================================
# 🌐 API KOBRALOST-RP (SYNCHRONISATION)
# ============================================
API_BASE_URL=https://dashboard.kobralost-rp.com/api/v2/1/836244875720523807
API_TOKEN=VOTRE_API_TOKEN_ICI


# ============================================
# 🎯 IDs SERVEUR DISCORD
# ============================================
SYNC_GUILD_ID=VOTRE_ID_SERVEUR_DISCORD_ICI


# ============================================
# 📺 SALONS DISCORD (IDs des channels)
# ============================================
WELCOME_CHANNEL_ID=VOTRE_ID_SALON_BIENVENUE_ICI
WELCOME_BG_URLS=https://i.imgur.com/EgG2BeB.png,https://i.imgur.com/TVKN7Pi.png,https://i.imgur.com/eBk9E3W.png
BOOST_CHANNEL_ID=VOTRE_ID_SALON_BOOST_ICI
SYNC_CHANNEL_ID=VOTRE_ID_SALON_SYNCHRONISATION_ICI
SYNC_LOG_CHANNEL_ID=VOTRE_ID_SALON_LOGS_SYNC_ICI
SYNC_NOTIF_CHANNEL_ID=VOTRE_ID_SALON_NOTIFICATIONS_ICI
LOGS_CHANNEL_ID=VOTRE_ID_SALON_LOGS_BOT_ICI
FREE_GAMES_CHANNEL_ID=VOTRE_ID_SALON_JEUX_GRATUITS_ICI
FREE_GAMES_PING_ROLE_ID=VOTRE_ID_ROLE_A_PING_ICI
FREE_GAMES_GUILD_ID=
FREE_GAMES_CHECK_INTERVAL_MINUTES=30
TICKET_CATEGORY_ID=VOTRE_ID_CATEGORIE_TICKETS_ICI
SUGGEST_CHANNEL_ID=VOTRE_ID_SALON_SUGGESTIONS_ICI


# ============================================
# 🎭 RÔLES DISCORD (IDs des roles)
# ============================================
MEMBER_ROLE_ID=VOTRE_ID_ROLE_MEMBRE_ICI
ADMIN_ROLE_ID=VOTRE_ID_ROLE_ADMIN_ICI


# ============================================
# ⚙️ PARAMÈTRES DE SYNCHRONISATION
# ============================================
API_DELAY_SECONDS=1.5
SYNC_INTERVAL_MINUTES=30
ROLE_DELAY_SECONDS=1
NICK_BATCH_SIZE=5
NICK_WINDOW_SECONDS=30
SLOW_SYNC_MEMBER_INTERVAL=60
LEVEL_CHANNEL_ID=VOTRE_ID_SALON_NIVEAUX_ICI
SLOW_SYNC_FULL_CYCLE_INTERVAL=86400


# ============================================
# TICKETS (PANEL / LOGS / IMAGES)
# ============================================
TICKET_STAFF_ROLE_ID=VOTRE_ID_ROLE_STAFF_TICKETS_ICI
TICKET_LOG_CHANNEL_ID=VOTRE_ID_SALON_LOGS_TICKETS_ICI
TICKET_IMAGE_COMMON=https://i.imgur.com/ZoOiFus.png
TICKET_IMAGE_CREATED=


# ============================================
# ⚙️ OPTIMISATION & LOGS
# ============================================
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_MAX_SIZE_MB=5
LOG_KEEP_FILES=7
LOG_DEDUPE_MS=2000


# ============================================
# 🏆 RÔLES DE RANG (PROGRESSION)
# ============================================
ROLE_TRANSCENDANT=
ROLE_LEGENDE=
ROLE_GRAND_CHAMPION=
ROLE_CHAMPION=
ROLE_ELITE=
ROLE_HORS_CLASSE=
ROLE_MAITRE=
ROLE_DIAMOND=
ROLE_PLATINUM=
ROLE_GOLD=
ROLE_SILVER=
ROLE_BRONZE=


# ============================================
# 🎮 CONFIGURATION INTEGRATION GMOD & BATTLEMETRICS
# ============================================
# ID BattleMetrics du serveur GMod (par défaut Kobralost)
GMOD_BATTLEMETRICS_ID=13412950

# URL de la collection Workshop Steam pour les addons du serveur
GMOD_COLLECTION_URL=https://kobralost-rp.fr/addons

# URL du Dashboard web du serveur
GMOD_DASHBOARD_URL=https://dashboard.kobralost-rp.fr/

# Adresse de connexion du serveur (ex: IP:PORT ou nom de domaine)
GMOD_SERVER_IP=play.kobralost-rp.fr

# Surcharge optionnelle du nom du serveur (laisse vide pour utiliser le nom BattleMetrics)
GMOD_SERVER_NAME_OVERRIDE=[FR] 💎 Kobralost Roleplay 🚀 | Exclu | 100K START | Famille | KBRP

# Activer l'affichage du statut du serveur GMod dans l'activité Discord rotative du bot
GMOD_STATUS_IN_PRESENCE=true


# ============================================
# 👋 DÉPARTS & CASIERS JUDICIAIRES (NOUVEAU)
# ============================================
# ID du salon Discord où envoyer les messages de départ (goodbye)
GOODBYE_CHANNEL_ID=VOTRE_ID_SALON_DEPARTS_ICI

# ID du rôle autorisé à voir les casiers judiciaires via /punishments (en plus des Admins)
PUNISHMENTS_VIEW_ROLE_ID=VOTRE_ID_ROLE_VOIR_PUNISHMENTS_ICI
